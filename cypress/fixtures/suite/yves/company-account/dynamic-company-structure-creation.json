        {
          "type": "helper",
          "name": "havePermissionByKey",
          "key": "createCompanyRoles",
          "arguments": ["CreateCompanyRolesPermissionPlugin"]
        },
        {
          "type": "helper",
          "name": "havePermissionByKey",
          "key": "seeCompanyUsers",
          "arguments": ["SeeCompanyUsersPermissionPlugin"]
        },
        {
          "type": "helper",
          "name": "havePermissionByKey",
          "key": "addCompanyUser",
          "arguments": ["AddCompanyUserPermissionPlugin"]
        },
        {
          "type": "helper",
          "name": "haveCompanyRoleWithPermissions",
          "key": "adminRole",
          "arguments": [
            {
              "fk_company": "#company.id_company"
            },
            ["#seeCompanyRoles", "#createCompanyRoles", "#seeCompanyUsers", "#addCompanyUser"]
