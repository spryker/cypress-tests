        {
          "type": "helper",
          "name": "haveShipmentType",
          "key": "shipmentTypeDelivery",
          "arguments": [
            {
              "key": "delivery"
            }
          ]
        },
        {
          "type": "helper",
          "name": "haveShipmentType",
          "key": "shipmentType",
          "arguments": [
            {
              "key": "in-center-service"
            }
          ]
        },
        {
          "type": "helper",
          "name": "haveServicePoint",
