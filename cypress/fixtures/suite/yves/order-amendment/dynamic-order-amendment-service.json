          "arguments": [
            {
              "idTaxSet": 1,
              "localizedAttributes": [
                {
                  "locale": "#localeEN",
                  "name": "#localizedAttributeService.name"
                },
                {
                  "locale": "#localeDE",
                  "name": "#localizedAttributeService.name"
                }
              ]
            },
            {
              "localizedAttributes": [
                {
                  "locale": "#localeEN",
                  "name": "#localizedAttributeService.name"
                },
                {
                  "locale": "#localeDE",
                  "name": "#localizedAttributeService.name"
                }
              ]
            }
          ]
        },
        {
          "type": "helper",
          "name": "haveFullProduct",
          "key": "productDelivery",
          "arguments": [
            {
              "idTaxSet": 1,
              "localizedAttributes": [
                {
                  "locale": "#localeEN",
                  "name": "#localizedAttributeDelivery.name"
                },
                {
                  "locale": "#localeDE",
                  "name": "#localizedAttributeDelivery.name"
                }
              ]
            },
            {
              "localizedAttributes": [
                {
                  "locale": "#localeEN",
                  "name": "#localizedAttributeDelivery.name"
                },
                {
                  "locale": "#localeDE",
                  "name": "#localizedAttributeDelivery.name"
                }
              ]
            }
          ]
        },
        {
          "type": "helper",
          "name": "haveActiveMerchantWithStore",
          "key": "merchant"
