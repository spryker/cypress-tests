{
  "data": {
    "type": "dynamic-fixtures",
    "attributes": {
      "synchronize": true,
      "operations": [
        {
          "type": "transfer",
          "name": "StoreTransfer",
          "key": "store",
          "arguments": {
            "id_store": 1,
            "name": "DE",
            "defaultCurrencyIsoCode": "EUR"
          }
        },
        {
          "type": "transfer",
          "name": "LocaleTransfer",
          "key": "localeEN",
          "arguments": {
            "id_locale": 66,
            "locale_name": "en_US"
          }
        },
        {
          "type": "transfer",
          "name": "LocaleTransfer",
          "key": "localeDE",
          "arguments": {
            "id_locale": 46,
            "locale_name": "de_DE"
          }
        },
        {
          "type": "builder",
          "name": "LocalizedAttributesBuilder",
          "key": "localizedAttributeService"
