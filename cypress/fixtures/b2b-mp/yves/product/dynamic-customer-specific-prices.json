{
  "data": {
    "type": "dynamic-fixtures",
    "attributes": {
      "synchronize": true,
      "operations": [
        {
          "type": "transfer",
          "name": "StoreTransfer",
          "key": "store",
          "arguments": {
            "id_store": 1
          }
        },
        {
          "type": "helper",
          "name": "getCurrencyByIsoCode",
          "key": "currency",
          "arguments": ["EUR"]
        },
        {
          "type": "transfer",
          "name": "LocaleTransfer",
          "key": "localeEN",
          "arguments": {
            "id_locale": 66,
            "locale_name": "en_US"
          }
        },
        {
          "type": "transfer",
          "name": "LocaleTransfer",
          "key": "localeDE",
          "arguments": {
            "id_locale": 46,
            "locale_name": "de_DE"
          }
        },
        {
          "type": "helper",
          "name": "haveCompany",
          "key": "company",
          "arguments": [
            {
              "isActive": true,
              "status": "approved"
            }
          ]
        },
        {
          "type": "helper",
          "name": "havePermissionByKey",
          "key": "addCartItemPermission",
          "arguments": ["AddCartItemPermissionPlugin"]
        },
        {
          "type": "helper",
          "name": "havePermissionByKey",
          "key": "changeCartItemPermission",
          "arguments": ["ChangeCartItemPermissionPlugin"]
        },
        {
          "type": "helper",
          "name": "havePermissionByKey",
          "key": "removeCartItemPermission",
          "arguments": ["RemoveCartItemPermissionPlugin"]
        },
        {
          "type": "helper",
          "name": "haveCompanyRoleWithPermissions",
          "arguments": [
            {
              "isDefault": true,
              "fkCompany": "#company.id_company"
            },
            ["#addCartItemPermission", "#changeCartItemPermission", "#removeCartItemPermission"]
          ]
        },
        {
          "type": "helper",
          "name": "haveCompanyBusinessUnit",
          "key": "defaultPriceBusinessUnit",
          "arguments": [
            {
              "fkCompany": "#company.id_company"
            }
          ]
        },
        {
          "type": "helper",
          "name": "haveCompanyBusinessUnit",
          "key": "merchantPriceBusinessUnit",
          "arguments": [
            {
              "fkCompany": "#company.id_company"
            }
          ]
        },
        {
          "type": "helper",
          "name": "haveConfirmedCustomer",
          "key": "defaultPriceCustomer",
          "arguments": [
            {
              "locale_name": "en_US",
              "password": "change123"
            }
          ]
        },
        {
          "type": "helper",
          "name": "haveCompanyUser",
          "arguments": [
            {
              "customer": "#defaultPriceCustomer",
              "fkCustomer": "#defaultPriceCustomer.id_customer",
              "fkCompany": "#company.id_company",
              "fkCompanyBusinessUnit": "#defaultPriceBusinessUnit.id_company_business_unit",
              "isActive": true,
              "isDefault": true
            }
          ]
        },
        {
          "type": "helper",
          "name": "haveConfirmedCustomer",
          "key": "merchantPriceCustomer",
          "arguments": [
            {
              "locale_name": "en_US",
              "password": "change123"
            }
          ]
        },
        {
          "type": "helper",
          "name": "haveCompanyUser",
          "arguments": [
            {
              "customer": "#merchantPriceCustomer",
              "fkCustomer": "#merchantPriceCustomer.id_customer",
              "fkCompany": "#company.id_company",
              "fkCompanyBusinessUnit": "#merchantPriceBusinessUnit.id_company_business_unit",
              "isActive": true,
              "isDefault": true
            }
          ]
        },
        {
          "type": "helper",
          "name": "haveActiveMerchantWithStore",
          "key": "merchant"
        },
        {
          "type": "helper",
          "name": "haveMerchantRelationship",
          "key": "merchantRelationship",
          "arguments": [
            {
              "fkMerchant": "#merchant.id_merchant",
              "fkCompanyBusinessUnit": "#merchantPriceBusinessUnit.id_company_business_unit",
              "assigneeCompanyBusinessUnits": {
                "companyBusinessUnits": [
                  {
                    "idCompanyBusinessUnit": "#merchantPriceBusinessUnit.id_company_business_unit"
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "builder",
          "name": "LocalizedAttributesBuilder",
          "key": "productName"
        },
        {
          "type": "transfer",
          "name": "ProductImageTransfer",
          "key": "productImage",
          "arguments": {
            "externalUrlSmall": "https://images.icecat.biz/img/gallery_mediums/30691822_1486.jpg",
            "externalUrlLarge": "https://images.icecat.biz/img/gallery/30691822_1486.jpg"
          }
        },
        {
          "type": "helper",
          "name": "haveFullProduct",
          "key": "product",
          "arguments": [
            {
              "localizedAttributes": [
                {
                  "locale": "#localeEN",
                  "name": "#productName.name"
                },
                {
                  "locale": "#localeDE",
                  "name": "#productName.name"
                }
              ]
            },
            {
              "idTaxSet": 1,
              "localizedAttributes": [
                {
                  "locale": "#localeEN",
                  "name": "#productName.name"
                },
                {
                  "locale": "#localeDE",
                  "name": "#productName.name"
                }
              ],
              "prices": [
                {
                  "priceTypeName": "DEFAULT",
                  "priceType": {
                    "name": "DEFAULT"
                  },
                  "priceDimension": {
                    "type": "PRICE_DIMENSION_DEFAULT"
                  },
                  "moneyValue": {
                    "fkStore": "#store.id_store",
                    "fkCurrency": "#currency.id_currency",
                    "netAmount": 9000,
                    "grossAmount": 10000
                  }
                },
                {
                  "priceTypeName": "DEFAULT",
                  "priceType": {
                    "name": "DEFAULT"
                  },
                  "priceDimension": {
                    "type": "PRICE_DIMENSION_MERCHANT_RELATIONSHIP",
                    "idMerchantRelationship": "#merchantRelationship.id_merchant_relationship"
                  },
                  "moneyValue": {
                    "fkStore": "#store.id_store",
                    "fkCurrency": "#currency.id_currency",
                    "netAmount": 7000,
                    "grossAmount": 8000
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "helper",
          "name": "haveProductInStockForStore",
          "arguments": [
            "#store",
            {
              "sku": "#product.sku",
              "isNeverOutOfStock": "1"
            }
          ]
        },
        {
          "type": "helper",
          "name": "haveProductImageSet",
          "arguments": [
            {
              "name": "default",
              "idProduct": "#product.id_product_concrete",
              "idProductAbstract": "#product.fk_product_abstract",
              "productImages": ["#productImage"]
            }
          ]
        }
      ]
    }
  }
}
